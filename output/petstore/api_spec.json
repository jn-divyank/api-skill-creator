        "pet"
      ],
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "required": true,
          "description": "ID of pet to update"
        },
        {
          "name": "additionalMetadata",
          "in": "formData",
          "required": false,
          "description": "Additional data to pass to server"
        },
        {
          "name": "file",
          "in": "formData",
          "required": false,
          "description": "file to upload"
        }
      ],
      "body_fields": [],
      "operation_id": "uploadFile"
    },
